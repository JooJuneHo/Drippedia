# Supabase - 서버리스는 커넥션을 자주 여니 transaction 모드 풀러(6543)를 써야 한다.
# Supabase 대시보드 > Connect > Transaction pooler 주소를 그대로.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# openssl rand -base64 32
AUTH_SECRET=

# Auth.js가 이 이름들을 알아서 찾는다(provider 설정에 따로 안 적어도 된다).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
